<Window x:Class="CrazyUniverse__ROBOT_PLANET_.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrazyUniverse__ROBOT_PLANET_.WpfApp"
        mc:Ignorable="d"
        Title="Robot Planet" Height="450" Width="800">
    <Grid>
        <Grid Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Robots" FontSize="18" FontWeight="Bold"/>

                <ListBox x:Name="RobotListBox" ItemsSource="{Binding Robots}" />
                
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20">

                <TextBlock Text="Add Robot" FontSize="18" FontWeight="Bold"/>

                <TextBlock Margin="0,10,0,0" Text="Robot Name:" />

                <TextBox x:Name="NameTextBox" Margin="0,10,0,0" Height="25" />

                <ComboBox x:Name="TypeComboBox" Margin="0,10,0,0" SelectedIndex="0">

                    <ComboBoxItem>CleanerBot</ComboBoxItem>
                    <ComboBoxItem>ExplorerBot</ComboBoxItem>
                    <ComboBoxItem>RepairBot</ComboBoxItem>
                    <ComboBoxItem>GuardBot</ComboBoxItem>

                </ComboBox>

                <WrapPanel Margin="0,10,0,10">

                    <Button Content="Add Robot" Click="AddRobot_Click"/>

                    <Button Content="Remove Robot" Margin="5,0,0,0" Click="RemoveRobot_Click"/>

                    <Button Content="Work" Margin="5,0,0,0" Click="Work_Click"/>

                    <Button Content="Crazy Action" Margin="5,0,0,0" Click="CrazyAction_Click"/>

                    <Button Content="Charge" Margin="5,0,0,0" Click="Charge_Click"/>

                    <Button Content="Scan" Margin="5,0,0,0" Click="Scan_Click"/>

                    <Button Content="Repair" Margin="5,0,0,0" Click="Repair_Click"/>

                </WrapPanel>

                <TextBlock Text="Robot Details" FontSize="20" FontWeight="Bold"/>

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Name:" />

                        <TextBlock FontSize="16" Text="{Binding ElementName=RobotListBox, Path=SelectedItem.Name}" />

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="Type:" />

                        <TextBlock FontSize="16" Text="{Binding ElementName=RobotListBox, Path=SelectedItem.RobotType}" />

                    </StackPanel>

                </Grid>

                <TextBlock Margin="0,20,0,0" Text="Battery:"/>

                <TextBlock FontSize="16" Text="{Binding ElementName=RobotListBox, Path=SelectedItem.BatteryLevel, StringFormat={}{0}%}"/>

                <ProgressBar Margin="0,10,0,0" Height="20" Minimum="0" Maximum="100" Value="{Binding ElementName=RobotListBox, Path=SelectedItem.BatteryLevel, Mode=OneWay}" />

                <TextBlock Margin="0,20,0,5" FontSize="18" FontWeight="Bold" Text="Log" />

                <ListBox x:Name="LogListBox" Height="356" />

            </StackPanel>

        </Grid>
    </Grid>
</Window>