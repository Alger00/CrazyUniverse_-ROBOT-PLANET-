<Window x:Class="CrazyUniverse__ROBOT_PLANET_.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrazyUniverse__ROBOT_PLANET_.WpfApp"
        mc:Ignorable="d"
        Title="Robot Planet"
        Height="800"
        Width="800">

    <Grid>
        <Grid Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Robots" FontSize="18" FontWeight="Bold"/>

                <ListBox x:Name="RobotListBox" ItemsSource="{Binding Robots}" SelectedItem="{Binding SelectedRobot}"/>

                <TextBlock Text="Search" Margin="0,10,0,5" FontWeight="Bold"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ListBox Height="150" Margin="0,5,0,10" ItemsSource="{Binding FilteredRobots}" />

                <TextBlock Text="Robot Summary" FontWeight="Bold"/>

                <ListBox Height="150" ItemsSource="{Binding RobotSummary}" />

                <TextBlock Text="Sorted By Name" Margin="0,10,0,5" FontWeight="Bold"/>

                <ListBox Height="150" ItemsSource="{Binding RobotsByName}" />

            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5">

                <TextBlock Text="Add Robot" FontSize="18" FontWeight="Bold"/>

                <TextBlock Margin="0,5,0,0" Text="Robot Name:"/>

                <TextBox Height="25" Text="{Binding RobotName, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Margin="0,5,0,0" ItemsSource="{Binding RobotTypes}" SelectedItem="{Binding SelectedRobotType}"/>

                <WrapPanel Margin="0,5,0,0">

                    <Button Content="Add Robot" Command="{Binding AddRobotCommand}"/>

                    <Button Content="Remove Robot" Margin="5,0,0,0" Command="{Binding RemoveRobotCommand}"/>

                    <Button Content="Work" Margin="5,0,0,0" Command="{Binding WorkCommand}"/>

                    <Button Content="Crazy Action" Margin="5,0,0,0" Command="{Binding CrazyActionCommand}"/>

                    <Button Content="Charge" Margin="5,0,0,0" Command="{Binding ChargeCommand}"/>

                    <Button Content="Scan" Margin="5,0,0,0" Command="{Binding ScanCommand}"/>

                    <Button Content="Repair" Margin="5,0,0,0" Command="{Binding RepairCommand}"/>

                </WrapPanel>

                <TextBlock Text="Robot Details" FontSize="20" FontWeight="Bold"/>

                <Grid Margin="0,5,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Name:" />

                        <TextBlock FontSize="16" Text="{Binding ElementName=RobotListBox, Path=SelectedItem.Name}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="Type:"/>

                        <TextBlock FontSize="16" Text="{Binding ElementName=RobotListBox, Path=SelectedItem.RobotType}"/>

                    </StackPanel>

                </Grid>

                <TextBlock Margin="0,5,0,0" Text="Battery:"/>

                <TextBlock FontSize="16" Text="{Binding ElementName=RobotListBox, Path=SelectedItem.BatteryLevel, StringFormat={}{0}%}"/>

                <ProgressBar Margin="0,5,0,0" Height="20" Minimum="0" Maximum="100" Value="{Binding ElementName=RobotListBox, Path=SelectedItem.BatteryLevel, Mode=OneWay}"/>

                <TextBlock Text="Simulation" FontSize="18" FontWeight="Bold" Margin="0,5,0,5"/>

                <TextBlock Text="Workload:"/>

                <TextBox Width="120" Text="{Binding Workload}"/>

                <TextBlock Text="Simulation Robots" FontWeight="Bold" Margin="0,5,0,5"/>

                <WrapPanel Margin="0,5,0,0">

                    <ComboBox Width="120" Margin="0,0,5,0" ItemsSource="{Binding Robots}" SelectedItem="{Binding SimulationRobot1}"/>

                    <ComboBox Width="120" Margin="0,0,5,0" ItemsSource="{Binding Robots}" SelectedItem="{Binding SimulationRobot2}"/>

                    <ComboBox Width="120" ItemsSource="{Binding Robots}" SelectedItem="{Binding SimulationRobot3}"/>

                </WrapPanel>

                <WrapPanel Margin="0,5,0,0">

                    <Button Content="Run Sequential" Command="{Binding RunSequentialCommand}"/>

                    <Button Content="Run Parallel" Margin="10,0,0,0" Command="{Binding RunParallelCommand}"/>

                    <Button Content="Cancel" Margin="10,0,0,0" Command="{Binding CancelCommand}"/>

                </WrapPanel>

                <TextBlock Text="Simulation Results" FontSize="18" FontWeight="Bold" Margin="0,5,0,5"/>

                <ListView Height="100" ItemsSource="{Binding SimulationResults}">

                    <ListView.View>

                        <GridView>

                            <GridViewColumn Header="Robot" Width="100" DisplayMemberBinding="{Binding RobotName}"/>

                            <GridViewColumn Header="Status" Width="65" DisplayMemberBinding="{Binding Status}"/>

                            <GridViewColumn Header="Result" Width="150" DisplayMemberBinding="{Binding Result}"/>

                            <GridViewColumn Header="Duration" Width="100" DisplayMemberBinding="{Binding DurationMs}"/>

                            <GridViewColumn Header="Error" Width="100" DisplayMemberBinding="{Binding ErrorMessage}"/>

                        </GridView>

                    </ListView.View>

                </ListView>

                <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="Bold" Text="Log"/>

                <ListBox x:Name="LogListBox" Height="165" ItemsSource="{Binding LogMessages}"/>

            </StackPanel>

        </Grid>
        
    </Grid>

</Window>